+@import "../../css/colors.css";
+
+.progress {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    width: 220px;
+    margin: 0 8px;
+}
+
+.track {
+    flex: 1;
+    height: 8px;
+    border-radius: 4px;
+    background: $ui-white-transparent;
+    overflow: hidden;
+}
+
+.fill {
+    height: 100%;
+    /* The scratch green of the flag (#4CBF56) — a compiled-and-running cue. */
+    background: #4CBF56;
+    transition: width 150ms linear;
+}
+
+.label {
+    font-size: 11px;
+    color: $ui-white;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    max-width: 110px;
+}
+
+.error {
+    font-size: 11px;
+    color: $control-primary;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    max-width: 220px;
+}
diff --git a/src/components/catnip-progress/catnip-progress.jsx b/src/components/catnip-progress/catnip-progress.jsx
new file mode 100644
index 0000000..2341e03
--- /dev/null
+++ b/src/components/catnip-progress/catnip-progress.jsx
@@ -0,0 +1,41 @@
+import React from 'react';
+
+import {getCatnipState, onCatnipStateChange} from '../../lib/catnip-bridge';
+import styles from './catnip-progress.css';
+
+/**
+ * The compile indicator in the menu bar: shows only while a project is
+ * being saved/compiled (and on errors) — the stage's own progress messages
+ * drive it through catnip-bridge.
+ */
+const CatnipProgress = () => {
+    const [state, setState] = React.useState(() => getCatnipState());
+
+    React.useEffect(() => onCatnipStateChange(setState), []);
+
+    if (state.phase === 'idle' || state.phase === 'running') return null;
+
+    if (state.phase === 'error') {
+        return (
+            <div className={styles.progress}>
+                <span className={styles.error}>{state.label}</span>
+            </div>
+        );
+    }
+
+    return (
+        <div className={styles.progress}>
+            <div className={styles.track}>
+                <div
+                    className={styles.fill}
+                    style={{width: `${Math.max(0, Math.min(100, state.pct))}%`}}
+                />
+            </div>
+            <span className={styles.label}>
+                {state.label} {state.pct}%
+            </span>
+        </div>
+    );
+};
+
+export default CatnipProgress;
