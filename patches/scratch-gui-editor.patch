diff --git a/src/lib/catnip-bridge.js b/src/lib/catnip-bridge.js
new file mode 100644
index 0000000..509b532
--- /dev/null
+++ b/src/lib/catnip-bridge.js
@@ -0,0 +1,72 @@
+/**
+ * Bridges the editor chrome to the catnip stage iframe:
+ * - green flag -> serialize the workspace (vm.saveProjectSb3) and hand the
+ *   bytes to the stage, which compiles and auto-runs;
+ * - stop -> freeze the stage simulation;
+ * - the stage's progress/ready/error messages -> a tiny store the menu-bar
+ *   progress bar subscribes to.
+ *
+ * The vm stays an editor + serializer: nothing here calls vm.greenFlag, so
+ * editing blocks while running only takes effect on the next flag click.
+ */
+
+let stageFrame = null;
+const listeners = new Set();
+let state = {phase: 'idle', pct: 0, label: ''};
+
+const setState = next => {
+    state = next;
+    for (const listener of listeners) listener(state);
+};
+
+/** Called by the stage component's iframe ref. */
+export const registerStageFrame = frame => {
+    stageFrame = frame;
+};
+
+export const getCatnipState = () => state;
+
+/** Subscribe to state changes; returns the unsubscribe function. */
+export const onCatnipStateChange = listener => {
+    listeners.add(listener);
+    return () => listeners.delete(listener);
+};
+
+/** Green flag: save the current project and load it into the stage. */
+export const catnipLoadProject = vm => {
+    if (!stageFrame || !stageFrame.contentWindow) return;
+    setState({phase: 'compiling', pct: 0, label: 'saving project'});
+    Promise.resolve(vm.saveProjectSb3())
+        .then(blob => blob.arrayBuffer())
+        .then(buffer => {
+            stageFrame.contentWindow.postMessage({kind: 'load', buffer}, '*');
+        })
+        .catch(err => setState({phase: 'error', pct: 0, label: String(err && err.message ? err.message : err)}));
+};
+
+/** Stop button: freeze the stage simulation. */
+export const catnipStop = () => {
+    if (stageFrame && stageFrame.contentWindow)
+        stageFrame.contentWindow.postMessage({kind: 'stop'}, '*');
+};
+
+// Progress relay from the iframe (its parent.postMessage targets "*").
+window.addEventListener('message', event => {
+    if (!stageFrame || event.source !== stageFrame.contentWindow) return;
+    const data = event.data;
+    if (!data || typeof data !== 'object') return;
+
+    switch (data.kind) {
+    case 'progress':
+        setState({phase: 'compiling', pct: data.pct, label: data.label});
+        break;
+    case 'ready':
+        setState({phase: 'running', pct: 100, label: ''});
+        break;
+    case 'error':
+        setState({phase: 'error', pct: 0, label: data.message || 'compile error'});
+        break;
+    default:
+        break;
+    }
+});
